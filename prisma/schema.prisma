datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model QuoteRequest {
  id              String   @id @default(uuid())
  companyName     String
  contactEmail    String
  contactPhone    String?
  deliveryPostcode String?
  productInterest String?
  quantity        String?
  projectNotes    String?
  propertyImages  String?
  createdAt       DateTime @default(now())
}

model ContactEnquiry {
  id          String   @id @default(uuid())
  name        String
  companyName String?
  email       String
  message     String
  createdAt   DateTime @default(now())
}

